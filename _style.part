<style>
  :root { color-scheme: light dark; }
  body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; line-height: 1.65; margin: 0 auto; max-width: 720px; padding: 32px 20px 72px; }
  h1 { font-size: 1.7rem; margin-bottom: 4px; }
  h2 { font-size: 1.05rem; margin-top: 32px; }
  .updated { color: #687080; font-size: .9rem; margin-top: 0; }
  .callout { border: 1px solid rgba(99,102,241,.5); border-radius: 10px; padding: 16px 18px; margin-top: 24px; }
  .callout .label { font-size: .78rem; letter-spacing: .08em; text-transform: uppercase; color: #6366F1; margin: 0 0 8px; font-weight: 600; }
  .callout p:last-child { margin-bottom: 0; }
  ul { padding-left: 20px; }
  li { margin: 10px 0; }
  footer { margin-top: 48px; color: #687080; font-size: .85rem; border-top: 1px solid rgba(127,127,127,.25); padding-top: 16px; }
  a { color: #3157D5; }
</style>
</head>
